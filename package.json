{
  "name": "inurse-cima",
  "version": "28.1.0",
  "description": "iNurse - Vademecum CIMA-AEMPS (proxy Node + frontend)",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "android:sync": "cap sync android",
    "android:assets": "python3 scripts/gen-android-assets.py && cap sync android",
    "android:open": "cap open android",
    "build:escalas": "node scripts/build-escalas.mjs",
    "verify:escalas": "node scripts/verify-escalas.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4"
  }
}
